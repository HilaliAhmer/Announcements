@{
    ViewData["Title"] = "Organization Chart";

}
@inject IConfiguration Configuration

<h2>MCC Korsini Organizasyon Şeması</h2>

<div class="mb-3 d-flex align-items-center" style="gap: 10px;">
    <input id="searchBox" type="text" class="form-control" style="max-width: 300px;"
           placeholder="Çalışan ara..." />
    @if (User.Identity.IsAuthenticated)
    {
        if (User.IsInRole("Admin"))
        {
            <button id="btnSyncAd" class="btn btn-sm btn-primary">
                AD Sync
            </button>
        }
    }

    <div class="ms-3 btn-group btn-group-sm" role="group" aria-label="View mode">
        <button type="button" id="btnModeOverview" class="btn btn-outline-secondary active">
            Management Team
        </button>
        <button type="button" id="btnModeDepartments" class="btn btn-outline-secondary">
            Departmans
        </button>
    </div>

    <div id="deptPager" class="ms-auto small text-muted"></div>
</div>

<div id="searchResults" class="list-group"
     style="position:absolute; z-index:1000; width:300px;"></div>

<div id="chartArea">
    <p>Loading data...</p>
</div>


@section Scripts {
    <script>
        window.orgChartSettings = {
            generalManagerSam: '@Configuration["OrgChart:GeneralManagerSam"]',
            plantManagerSam: '@Configuration["OrgChart:PlantManagerSam"]'
        };
    </script>
    <script src="~/js/orgchart.js" asp-append-version="true"></script>
}



